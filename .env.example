# =========================
# APPLICATION
# =========================
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
APP_NAME=Sami Furniture Accountant API
# Comma-separated origins, or * for all
CORS_ORIGINS=*

# =========================
# DATABASE (MySQL) — not connected until configured
# =========================
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=sami_modern
DB_LOGGING=false
# Dev: auto-create/update tables. Set to false before production (use migrations).
DB_SYNCHRONIZE=true

# =========================
# JWT
# =========================
JWT_SECRET=sami123
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=sami123
JWT_REFRESH_EXPIRES_IN=30d

# =========================
# SWAGGER
# =========================
SWAGGER_ENABLED=true
SWAGGER_TITLE=Sami Furniture Accountant API
SWAGGER_DESCRIPTION=Sami Furniture Accountant ERP — REST API documentation
SWAGGER_VERSION=1.0
SWAGGER_PATH=docs
