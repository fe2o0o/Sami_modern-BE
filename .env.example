# =============================================================================
# Sami Modern Backend — Environment template
# Copy to `.env` and fill in REAL values on each machine. NEVER commit `.env`.
# In production set every value explicitly; do not rely on code defaults.
# =============================================================================

# =========================
# APPLICATION
# =========================
# Use `production` on the VPS. Controls Swagger/logging/synchronize guards.
NODE_ENV=production
PORT=3000
API_PREFIX=api/v1
APP_NAME=Sami Modern API
# Comma-separated allowed origins (NO trailing slash), or * for all.
# Production example: https://app.samymodern.io,https://samymodern.io
CORS_ORIGINS=https://app.samymodern.io

# =========================
# DATABASE (MySQL — local to the VPS, do NOT expose 3306 publicly)
# =========================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME
DB_DATABASE=sami_modern
DB_LOGGING=false
# Schema management. Keep FALSE in production — migrations own the schema.
# (Even if set true, it is force-disabled when NODE_ENV=production.)
DB_SYNCHRONIZE=false

# =========================
# JWT — REQUIRED. Generate strong random values, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Use two DIFFERENT secrets. The app refuses to start if either is missing.
# =========================
JWT_SECRET=CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_A_DIFFERENT_LONG_RANDOM_SECRET
JWT_REFRESH_EXPIRES_IN=30d

# =========================
# SWAGGER — set SWAGGER_ENABLED=false in production to hide API docs.
# =========================
SWAGGER_ENABLED=false
SWAGGER_TITLE=Sami Modern API
SWAGGER_DESCRIPTION=Sami Modern ERP — REST API documentation
SWAGGER_VERSION=1.0
SWAGGER_PATH=docs
